# Local application
APP_ENV=local
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=file:./data/local.sqlite
CRM_AGENT_PROVIDER_MODE=bailian

# Aliyun Bailian — keep real values only in .env
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_KNOWLEDGE_SEARCH_AGENT_ID=
BAILIAN_KNOWLEDGE_BASE_ID=
BAILIAN_MODEL_ID=qwen3.7-plus
# Per-attempt model timeout. The retry count remains application-controlled.
BAILIAN_MODEL_TIMEOUT_MS=90000
